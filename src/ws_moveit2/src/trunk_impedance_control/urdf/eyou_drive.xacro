<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="eyou_drive">

  <link name="base_link"/>
  <link name="motor_link"/>

  <joint name="motor_joint" type="continuous">
    <parent link="base_link"/>
    <child link="motor_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <ros2_control name="eyou_system" type="system">
    <hardware>
      <plugin>ethercat_driver/EthercatDriver</plugin>
      <param name="master_id">0</param>
      <param name="control_frequency">500</param>
    </hardware>

    <joint name="motor_joint">
      <command_interface name="effort"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>

      <ec_module name="eyou_drive">
        <plugin>ethercat_generic_plugins/EcCiA402Drive</plugin>
        <param name="alias">0</param>
        <param name="position">0</param>
        <param name="mode_of_operation">10</param>
        <param name="slave_config">$(find trunk_impedance_control)/config/eyou_slave_cst.yaml</param>
      </ec_module>
    </joint>
  </ros2_control>

</robot>
